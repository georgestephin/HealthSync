{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HealthSync: run app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "jinja": true,
      "env": { "SECRET_KEY": "dev-only-change-me" }
    },
    {
      "name": "HealthSync: run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v"],
      "console": "integratedTerminal"
    }
  ]
}
